    (Mac)      tar czf - file1 dir/ | s3tx send - bundle.tgz --to laptop
    (far end)  tx get CODE                      (then: tar xzf bundle.tgz)
"""

# --- tiny color helpers (quiet when not a TTY or NO_COLOR is set) ---
_tty = sys.stdout.isatty() and not os.environ.get("NO_COLOR")


def _c(code, s):
    return f"\033[{code}m{s}\033[0m" if _tty else s


def info(s):
    print(_c("36", s))


def ok(s):
    print(_c("32", s))


def warn(s):
    print(_c("33", s), file=sys.stderr)


def die(s):
    print(_c("31", f"Error: {s}"), file=sys.stderr)
    sys.exit(1)


# --- configuration: ~/.config/s3tx/config, with [profile] sections ---------------------
# KEY=VALUE lines named like the environment variables, `#` comments, optional quotes and
# `export`, and [name] headers; lines before any header belong to [default]. The file is
# read, never executed; tx reads ~/.config/tx/config with the same grammar. The default
# profile lets the environment override the file. A profile chosen with --profile stands
# alone: only its own lines count, never the environment's or [default]'s.

_SETTINGS = {  # every setting, with its built-in default
    "S3TX_AWS_PROFILE": "s3tx",
    "S3TX_BUCKET": "s3tx",
    "S3TX_REGION": "us-east-1",
    "S3TX_ENDPOINT_URL": "",
    "S3TX_CA_BUNDLE": "",
    "S3TX_EXPIRES": "600",
    "S3TX_MANIFEST_KEY": ".s3tx-manifest",
    "S3TX_MEDIATOR": "",
    "S3TX_ADMIN_TOKEN": "",
}
_SECRET_SETTINGS = {"S3TX_ADMIN_TOKEN"}
_ALIASES = {"S3TX_PROFILE": "S3TX_AWS_PROFILE"}  # v1 name -> current name
CONFIG_SETTINGS = {}  # the resolved profile: {KEY: (value, source)}

_HEADER = re.compile(r"\[[ \t]*([A-Za-z0-9_.-]+)[ \t]*\][ \t]*(#.*)?")
_ASSIGN = re.compile(r"(?:export[ \t]+)?([A-Za-z_][A-Za-z0-9_]*)[ \t]*=[ \t]*(.*)")


class _ConfigError(Exception):
    def __init__(self, line, msg):
        super().__init__(f"line {line}: {msg}")
        self.line = line


def _parse_config(text):
    """{section: {KEY: value}} from a config file's text."""
    sections = {"default": {}}
    current = "default"
    for n, raw in enumerate(text.split("\n"), 1):
        line = raw.strip(" \t\r")
        if not line or line.startswith("#"):
            continue
        if line.startswith("["):
            m = _HEADER.fullmatch(line)
            if not m:
                raise _ConfigError(n, "a section header is [name]: letters, digits, '.', '_', '-'")
            current = m.group(1)
            sections.setdefault(current, {})
            continue
        m = _ASSIGN.fullmatch(line)
        if not m:
            raise _ConfigError(n, "expected KEY=VALUE or a [section] header")
        key, rest = m.groups()
        if rest[:1] in ("'", '"'):
            end = rest.find(rest[0], 1)
            if end < 0:
                raise _ConfigError(n, "the quoted value never ends")
            value, tail = rest[1:end], rest[end + 1 :]
        elif rest.startswith("#"):
            value, tail = "", ""
        else:
            value, tail = re.match(r"([^ \t]*)(.*)", rest).groups()
        tail = tail.strip(" \t")
        if tail and not tail.startswith("#"):
            raise _ConfigError(n, "a value with spaces needs quotes")
        sections[current][key] = value
    return sections


def _config_path():
    return Path.home() / ".config" / "s3tx" / "config"


def _env_setting(key):
    """The environment's value for KEY (or its v1 alias), None when unset."""
    if key in os.environ:
        return os.environ[key]
    old = next((o for o, n in _ALIASES.items() if n == key and o in os.environ), None)
    return os.environ[old] if old else None


def _resolve(profile=None):
    """(name, {KEY: (value, source)}) for PROFILE, 'default' when none is named."""
    name = profile or "default"
    path = _config_path()
    sections = {}
    if path.is_file():
        if path.stat().st_mode & 0o077:
            warn(
                f"{path} is readable by other users, and it can hold S3TX_ADMIN_TOKEN: chmod 600 it."
            )
        try:
            sections = _parse_config(path.read_text())
        except _ConfigError as e:
            die(f"{path}, {e}")
        except (OSError, UnicodeDecodeError) as e:
            die(f"cannot read {path} ({e.__class__.__name__})")
    if name != "default" and name not in sections:
        where = f"in {path}" if path.is_file() else f"because {path} does not exist"
        die(f"there is no profile [{name}] {where}")
    section = dict(sections.get(name, {}))
    for old, new in _ALIASES.items():
        if old in section and new not in section:
            section[new] = section[old]
    resolved = {}
    for key, default in _SETTINGS.items():
        value, source = (section[key], "file") if key in section else (default, "built-in")
        env = _env_setting(key) if name == "default" else None
        resolved[key] = (env, "env") if env is not None else (value, source)
    return name, resolved


def _apply(name, resolved):
    """Make a resolved profile the settings in use."""
    global CONFIG_PROFILE, CONFIG_SETTINGS, PROFILE, BUCKET, REGION, EXPIRES, MANIFEST_KEY
    global MEDIATOR, ADMIN_TOKEN, ENDPOINT_URL, CA_BUNDLE, _SESSION
    v = {k: value for k, (value, _src) in resolved.items()}
    CONFIG_PROFILE, CONFIG_SETTINGS = name, resolved
    PROFILE, BUCKET, REGION = v["S3TX_AWS_PROFILE"], v["S3TX_BUCKET"], v["S3TX_REGION"]
    EXPIRES = _as_int("S3TX_EXPIRES", v["S3TX_EXPIRES"], 600)
    MANIFEST_KEY = v["S3TX_MANIFEST_KEY"]
    MEDIATOR, ADMIN_TOKEN = v["S3TX_MEDIATOR"].rstrip("/"), v["S3TX_ADMIN_TOKEN"]
    ENDPOINT_URL, CA_BUNDLE = v["S3TX_ENDPOINT_URL"], v["S3TX_CA_BUNDLE"]
    _SESSION = None


# boto3 is imported lazily inside these helpers so that `s3tx` / `s3tx -h`
# work with no dependencies and no credentials.
_SESSION = None


def _session():
    """A boto3 Session pinned to the AWS profile S3TX_AWS_PROFILE, so the tool uses its
    own least-privilege IAM user and never the shell's default credentials. Set it empty
    to use the standard boto3 chain instead."""
    global _SESSION
    if _SESSION is None:
        import boto3
        from botocore.exceptions import ProfileNotFound

        try:
            _SESSION = boto3.Session(profile_name=PROFILE or None, region_name=REGION)
        except ProfileNotFound:
            die(
                f"AWS profile '{PROFILE}' not found. Create it with "
                f"'aws configure --profile {PROFILE}', or set S3TX_AWS_PROFILE= to use "
                "the default credentials."
            )
    return _SESSION


def _s3(region=None):
    from botocore.config import Config

    extra = {"endpoint_url": ENDPOINT_URL} if ENDPOINT_URL else {}
    if CA_BUNDLE:
        extra["verify"] = CA_BUNDLE
    region = region or REGION
    # boto3 presigns S3 URLs with the deprecated SigV2 unless told otherwise; the 7-day
    # cap above, and every link the far end receives, assume SigV4.
    s3 = _session().client(
        "s3", region_name=region, config=Config(signature_version="s3v4"), **extra
    )
    if _on_aws(s3):
        return s3
    # An S3-compatible server: path-style addresses work on every one of them, and
    # checksums are sent only where the S3 API requires one, since boto3's newer
    # defaults are refused by many such servers.
    compat = Config(
        signature_version="s3v4",
        s3={"addressing_style": "path"},
        request_checksum_calculation="when_required",
        response_checksum_validation="when_required",
    )
    return _session().client("s3", region_name=region, config=compat, **extra)


def _on_aws(s3):
    """True when the client talks to AWS itself rather than to an S3-compatible endpoint
    (set through AWS_ENDPOINT_URL or a profile's endpoint_url, for instance)."""
    from urllib.parse import urlsplit

    host = urlsplit(s3.meta.endpoint_url).hostname or ""
    return host.endswith((".amazonaws.com", ".amazonaws.com.cn"))


def _warn_builtin_bucket():
    """The built-in S3TX_BUCKET is the author's own bucket's name: 2.0 drops it."""
    if CONFIG_SETTINGS.get("S3TX_BUCKET", ("", ""))[1] == "built-in":
        warn(
            f"S3TX_BUCKET is not set, so s3tx uses its built-in default '{BUCKET}'. Set it in "
            f"{_config_path()}: s3tx 2.0 drops the default."
        )


def _preflight():
    """Verify credentials and that the bucket already exists. Never creates anything.
    On AWS the credentials are checked with STS; an S3-compatible server has no STS, so
    there the bucket check alone stands for both. Returns (s3, identity or None)."""
    _warn_builtin_bucket()
    s3 = _s3()
    ident = None
    if _on_aws(s3):
        where = f"profile '{PROFILE}'" if PROFILE else "the default credential chain"
        try:
            ident = _session().client("sts").get_caller_identity()
        except Exception as e:
            die(
                f"AWS credentials for {where} are not available or not authorized "
                f"({e.__class__.__name__})."
            )
    try:
        head = s3.head_bucket(Bucket=BUCKET)
    except Exception as e:
        place = f"in {REGION}" if _on_aws(s3) else f"at {s3.meta.endpoint_url}"
        die(
            f"bucket s3://{BUCKET} is not accessible {place} "
            f"({e.__class__.__name__}). s3tx never creates buckets."
        )
    # A SigV4 link carries the region, and AWS refuses one signed for the wrong region.
    # So on AWS, sign for the region the bucket really lives in, whatever S3TX_REGION
    # says. Any other endpoint keeps the configured region: what it accepts is its own.
    actual = head.get("ResponseMetadata", {}).get("HTTPHeaders", {}).get("x-amz-bucket-region")
    if actual and actual != s3.meta.region_name and _on_aws(s3):
        s3 = _s3(actual)
    return s3, ident


def _expiry_note(secs):
    at = time.strftime("%H:%M", time.localtime(time.time() + secs))
    info(
        f"\nLink expires in {secs}s (~{max(1, secs // 60)} min, at {at}). Treat it as a "
        "secret; the real expiry is also capped by your AWS session length."
    )


def _public_state(s3):
    try:
        pab = s3.get_public_access_block(Bucket=BUCKET)["PublicAccessBlockConfiguration"]
    except Exception:
        return False, "no Block-Public-Access config set; run: s3tx lockdown"
    flags = ("BlockPublicAcls", "IgnorePublicAcls", "BlockPublicPolicy", "RestrictPublicBuckets")
    if all(pab.get(f) for f in flags):
        return True, "private (all four Block-Public-Access flags ON)"
    return False, "PARTIALLY OPEN; run: s3tx lockdown"


def _manifest_read(s3):
    """Return [(code, expires_epoch, url)]; a missing/garbled manifest -> []."""
    try:
        body = s3.get_object(Bucket=BUCKET, Key=MANIFEST_KEY)["Body"].read().decode("utf-8")
    except Exception:
        return []
    out = []
    for line in body.splitlines():
        parts = line.split("\t")
        if len(parts) == 3 and parts[1].isdigit():
            out.append((parts[0], int(parts[1]), parts[2]))
    return out


def _manifest_write(s3, entries):
    body = "".join(f"{c}\t{e}\t{u}\n" for c, e, u in entries)
    s3.put_object(
        Bucket=BUCKET, Key=MANIFEST_KEY, Body=body.encode("utf-8"), ContentType="text/plain"
    )


def _manifest_upsert(s3, code, url, expires):
    now = int(time.time())
    kept = [(c, e, u) for (c, e, u) in _manifest_read(s3) if e > now and c != code]
    kept.append((code, now + expires, url))
    _manifest_write(s3, kept)


_CODE_ALPHABET = "23456789abcdefghijkmnpqrstuvwxyzABCDEFGHJKLMNPQRSTUVWXYZ"


def _gen_code(n=8):
    return "".join(secrets.choice(_CODE_ALPHABET) for _ in range(n))


def _clamp_expires(secs):
    """Pre-signed URLs can't outlive SigV4's 7-day cap; clamp so we never mint a
    link S3 will reject at redeem time."""
    return max(1, min(secs, MAX_EXPIRES))


class _CodeExists(Exception):
    """The mediator already holds a live code with this value (HTTP 409)."""


def _mediator_register(code, url, client, method, ttl):
    import json
    import urllib.error
    import urllib.request

    if not MEDIATOR or not ADMIN_TOKEN:
        die("S3TX_MEDIATOR and S3TX_ADMIN_TOKEN must be set to use --to.")
    body = json.dumps(
        {"code": code, "url": url, "client": client, "method": method, "ttl": ttl}
    ).encode()
    req = urllib.request.Request(
        f"{MEDIATOR}/api/register",
        data=body,
        method="POST",
        headers={"Content-Type": "application/json", "Authorization": f"Bearer {ADMIN_TOKEN}"},
    )
    try:
        reply = urllib.request.urlopen(req, timeout=10).read()
    except urllib.error.HTTPError as e:
        if e.code == 409:
            raise _CodeExists from None
        die(f"mediator register failed (HTTP {e.code}): {e.read().decode()[:200]}")
    except Exception as e:
        die(f"mediator unreachable: {e}")
    # The mediator clamps ttl to 30..900 s and answers with what it granted: that, not
    # the request, is how long the code lives. Fall back to the request if it is silent.
    try:
        return int(json.loads(reply).get("ttl", ttl))
    except (ValueError, TypeError, AttributeError):
        return ttl


def _register_with_retry(url, client, method, ttl, tries=5):
    """Allocate a unique short code at the mediator, regenerating on the rare
    collision (HTTP 409) rather than failing. Returns (code, seconds it lives)."""
    for _ in range(tries):
        code = _gen_code(8)
        try:
            return code, _mediator_register(code, url, client, method, ttl)
        except _CodeExists:
            continue
    die("could not allocate a unique code after several tries; please retry.")


def _emit_get(s3, key, url, args):
    """Print the right thing for a GET pre-signed URL: a mediator code (--to),
    a manifest code (--code), or the raw time-limited URL."""
    lives = args.expires
    if args.to:
        code, lives = _register_with_retry(url, args.to, "GET", args.expires)
        ok(f"Registered for client '{args.to}' (single-use, expires {lives}s). On that machine:")
        print(f"  tx get {code}")
    elif args.code is not None:
        code = _gen_code() if args.code == "__auto__" else args.code
        _manifest_upsert(s3, code, url, args.expires)
        ok(
            f"Registered as manifest code (expires {args.expires}s). On the far end (TX_MANIFEST seeded):"
        )
        print(f"  tx get {code}")
    else:
        ok(f"Time-limited download link (expires {args.expires}s):")
        print(url)
        info('On the far end:  tx get "<that url>"   (or: curl -L -O "<that url>")')
    _expiry_note(lives)


class _HashingReader:
    """A stream that keeps the SHA-256 of everything read through it."""

    def __init__(self, raw):
        self._raw = raw
        self.sha256 = hashlib.sha256()

    def read(self, size=-1):
        data = self._raw.read(size)
        self.sha256.update(data)
        return data


def _file_sha256(path):
    h = hashlib.sha256()
    with open(path, "rb") as f:
        for chunk in iter(lambda: f.read(1 << 20), b""):
            h.update(chunk)
    return h.hexdigest()


# send records the file's SHA-256 as object metadata; S3 returns it with every download
# as x-amz-meta-sha256, and tx get checks the file against it.
def cmd_send(args):
    if args.file == "-":
        if not args.key:
            die("reading from stdin needs an explicit key, e.g. s3tx send - bundle.tgz --to laptop")
        key = args.key
        s3, _ = _preflight()
        info(f"Uploading (stdin) to s3://{BUCKET}/{key} ...")
        stream = _HashingReader(sys.stdin.buffer)
        s3.upload_fileobj(stream, BUCKET, key)  # boto3 multipart: handles a pipe
        # A pipe's digest is known only at its end: record it by copying the object onto
        # itself with the new metadata, which S3 does without the data passing through here.
        try:
            s3.copy(
                {"Bucket": BUCKET, "Key": key},
                BUCKET,
                key,
                ExtraArgs={
                    "Metadata": {"sha256": stream.sha256.hexdigest()},
                    "MetadataDirective": "REPLACE",
                },
            )
        except Exception as e:
            warn(
                f"Could not record the SHA-256 ({e.__class__.__name__}): tx get will not check it."
            )
    else:
        if not os.path.isfile(args.file):
            die(f"file not found: {args.file}")
        key = args.key or os.path.basename(args.file)
        s3, _ = _preflight()
        info(f"Uploading {args.file} to s3://{BUCKET}/{key} ...")
        meta = {"Metadata": {"sha256": _file_sha256(args.file)}}
        s3.upload_file(args.file, BUCKET, key, ExtraArgs=meta)
    url = s3.generate_presigned_url(
        "get_object", Params={"Bucket": BUCKET, "Key": key}, ExpiresIn=args.expires
    )
    _emit_get(s3, key, url, args)


def _require_object(s3, key):
    """Die unless KEY exists. Only a 404 means "not found"; any other error is raised
    as itself, so a permission problem is never reported as a missing object."""
    from botocore.exceptions import ClientError

    try:
        s3.head_object(Bucket=BUCKET, Key=key)
    except ClientError as e:
        if e.response.get("Error", {}).get("Code") in ("404", "NoSuchKey", "NotFound"):
            die(f"object not found: s3://{BUCKET}/{key}")
        raise


def cmd_link(args):
    s3, _ = _preflight()
    _require_object(s3, args.key)
    url = s3.generate_presigned_url(
        "get_object", Params={"Bucket": BUCKET, "Key": args.key}, ExpiresIn=args.expires
    )
    _emit_get(s3, args.key, url, args)


def cmd_drop(args):
    s3, _ = _preflight()
    url = s3.generate_presigned_url(
        "put_object", Params={"Bucket": BUCKET, "Key": args.key}, ExpiresIn=args.expires
    )
    if args.to:
        code, lives = _register_with_retry(url, args.to, "PUT", args.expires)
        ok(f"Upload slot registered for client '{args.to}' (single-use, expires {lives}s).")
        info("\nOn that machine (tx with TX_MEDIATOR + TX_CLIENT_ID set):")
        print(f"  tx put <localfile> {code}")
        info(f"Then pull it here:  s3tx recv {args.key}")
        _expiry_note(lives)
        return
    ok(f"Upload link for s3://{BUCKET}/{args.key} (far end needs no AWS creds):")
    print(url)
    info("\nOn the far end (a laptop, a Pi, ...):")
    print(f'  tx put <localfile> "{url}"')
    info("  ...or with plain curl:")
    print(f'  curl -X PUT --upload-file <localfile> "{url}"')
    info(f"Then pull it here:  s3tx recv {args.key}")
    _expiry_note(args.expires)


def cmd_recv(args):
    s3, _ = _preflight()
    out = args.outfile or os.path.basename(args.key)
    info(f"Downloading s3://{BUCKET}/{args.key} to {out} ...")
    s3.download_file(BUCKET, args.key, out)
    ok(f"Saved {out}")


def cmd_ls(args):
    s3, _ = _preflight()
    n = 0
    for page in s3.get_paginator("list_objects_v2").paginate(
        Bucket=BUCKET, Prefix=args.prefix or ""
    ):
        for o in page.get("Contents", []):
            print(f"{o['LastModified']:%Y-%m-%d %H:%M}  {o['Size']:>12,}  {o['Key']}")
            n += 1
    if not n:
        info("(empty)")


def cmd_rm(args):
    s3, _ = _preflight()
    _require_object(s3, args.key)  # S3 "deletes" a missing key happily; say so instead
    s3.delete_object(Bucket=BUCKET, Key=args.key)
    ok(f"Deleted s3://{BUCKET}/{args.key}")


def cmd_rmrf(args):
    s3, _ = _preflight()
    warn(f"This will DELETE ALL objects in s3://{BUCKET}")
    if input("Type DELETE to confirm: ") != "DELETE":
        warn("Cancelled.")
        sys.exit(1)
    keys = [
        {"Key": o["Key"]}
        for page in s3.get_paginator("list_objects_v2").paginate(Bucket=BUCKET)
        for o in page.get("Contents", [])
    ]
    for i in range(0, len(keys), 1000):
        s3.delete_objects(Bucket=BUCKET, Delete={"Objects": keys[i : i + 1000]})
    ok(f"Emptied ({len(keys)} objects).")


def cmd_status(args):
    s3, ident = _preflight()
    info(f"Config   : profile [{CONFIG_PROFILE}]")
    info(f"Profile  : {PROFILE or '(default credential chain)'}")
    if ident is None:
        info(f"Endpoint : {s3.meta.endpoint_url}")
        info("Identity : not checked (an AWS check; this endpoint is not AWS)")
    else:
        info(f"Identity : {ident['Arn']}")
    info(f"Bucket   : s3://{BUCKET}    Region: {s3.meta.region_name}")
    if ident is None:
        info("Public access: not checked (Block Public Access is an AWS setting); keep the")
        info("               bucket private with the server's own controls.")
        return
    private, desc = _public_state(s3)
    (ok if private else warn)(f"Public access: {desc}")


def cmd_lockdown(args):
    s3, _ = _preflight()
    if not _on_aws(s3):
        die(
            "lockdown sets AWS Block Public Access, and this endpoint is not AWS; keep the "
            "bucket private with the server's own controls."
        )
    s3.put_public_access_block(
        Bucket=BUCKET,
        PublicAccessBlockConfiguration={
            "BlockPublicAcls": True,
            "IgnorePublicAcls": True,
            "BlockPublicPolicy": True,
            "RestrictPublicBuckets": True,
        },
    )
    with contextlib.suppress(Exception):
        s3.delete_bucket_policy(Bucket=BUCKET)
    ok("Locked down: all Block-Public-Access flags ON, any bucket policy removed.")


def cmd_manifest_url(args):
    s3, _ = _preflight()
    days = max(1, min(args.days, 7))
    if not _manifest_read(s3):
        _manifest_write(s3, [])  # ensure the object exists so the seed URL resolves
    url = s3.generate_presigned_url(
        "get_object", Params={"Bucket": BUCKET, "Key": MANIFEST_KEY}, ExpiresIn=days * 86400
    )
    ok(f"Manifest seed URL (valid {days} day(s); SigV4 allows at most 7):")
    print(url)
    info("\nSeed it on the far end once, then 'tx get <code>' works:")
    print(f'  export TX_MANIFEST="{url}"')
    info("  ...or persist it (tx reads this when the env var is unset):")
    print(f'  mkdir -p ~/.config/tx && printf %s "{url}" > ~/.config/tx/manifest.url')


def cmd_config(args):
    """Show the settings in effect and where each one comes from; secrets are masked."""
    path = _config_path()
    found = "" if path.is_file() else ", which does not exist"
    info(f"Profile [{CONFIG_PROFILE}] from {path}{found}")
    for key, (value, source) in CONFIG_SETTINGS.items():
        shown = f"<set, {len(value)} characters>" if key in _SECRET_SETTINGS and value else value
        print(f"{key}={shown}  [{source}]")


def _http_status(url, data=None, headers=None):
    """(status, Date header, None) for a request, or (None, None, reason) when nothing
    answered. data makes it a POST."""
    import urllib.error
    import urllib.request

    req = urllib.request.Request(url, data=data, headers=headers or {})
    try:
        with urllib.request.urlopen(req, timeout=10) as r:
            return r.status, r.headers.get("Date"), None
    except urllib.error.HTTPError as e:
        return e.code, e.headers.get("Date"), None
    except Exception as e:
        return None, None, str(getattr(e, "reason", "") or e.__class__.__name__)


def cmd_doctor(args):
    """Check the setup end to end, one line per check, and exit 1 when one fails."""
    global _SESSION
    import shutil
    import subprocess
    from email.utils import parsedate_to_datetime

    counts = {"ok": 0, "warn": 0, "fail": 0, "skip": 0}

    def line(state, text):
        color = {"ok": "32", "warn": "33", "fail": "31", "skip": "36"}[state]
        label = (state.upper() if state == "fail" else state).ljust(4)
        print(f"{_c(color, label)}  {text}")
        counts[state] += 1

    # The tool itself.
    py = ".".join(str(n) for n in sys.version_info[:3])
    try:
        import boto3
    except ImportError:
        boto3 = None
    what = f"s3tx {__version__}, Python {py}" + (f", boto3 {boto3.__version__}" if boto3 else "")
    if boto3 is None:
        line("fail", f"{what}: boto3 is not installed (uv installs it when it runs s3tx)")
    elif sys.version_info < (3, 11):
        line("warn", f"{what}: Python {py} is past its end of life; s3tx supports 3.11 or later")
    else:
        line("ok", what)

    # The config file and the bucket setting.
    path = _config_path()
    if not path.is_file():
        line("skip", f"no {path}: the settings come from the environment and the defaults")
    elif path.stat().st_mode & 0o077:
        line("warn", f"{path} is readable by other users, and it can hold a token: chmod 600 it")
    else:
        line("ok", f"config {path}, profile [{CONFIG_PROFILE}]")
    if CONFIG_SETTINGS.get("S3TX_BUCKET", ("", ""))[1] == "built-in":
        line("warn", f"S3TX_BUCKET is the built-in default '{BUCKET}': set it, s3tx 2.0 drops it")

    # Storage: the credentials, the bucket, and on AWS its Block Public Access.
    server_date = None
    if boto3 is not None:
        from botocore.exceptions import ProfileNotFound

        where = f"profile '{PROFILE}'" if PROFILE else "the default credential chain"
        try:
            _SESSION = boto3.Session(profile_name=PROFILE or None, region_name=REGION)
        except ProfileNotFound:
            line("fail", f"AWS profile '{PROFILE}' not found: aws configure --profile {PROFILE}")
        else:
            s3 = _s3()
            aws = _on_aws(s3)
            if aws:
                try:
                    arn = _session().client("sts").get_caller_identity()["Arn"]
                    line("ok", f"credentials, {where}: {arn}")
                except Exception as e:
                    line("fail", f"credentials, {where}: not usable ({e.__class__.__name__})")
            else:
                line("skip", f"credentials: not checked, {s3.meta.endpoint_url} is not AWS")
            try:
                head = s3.head_bucket(Bucket=BUCKET)
            except Exception as e:
                line("fail", f"bucket s3://{BUCKET}: not accessible ({e.__class__.__name__})")
            else:
                hdrs = head.get("ResponseMetadata", {}).get("HTTPHeaders", {})
                region = hdrs.get("x-amz-bucket-region") or s3.meta.region_name
                server_date = hdrs.get("date")
                line("ok", f"bucket s3://{BUCKET} in {region}")
                if not aws:
                    line(
                        "skip", "public access: not checked, Block Public Access is an AWS setting"
                    )
                else:
                    if region != s3.meta.region_name:
                        s3 = _s3(region)
                    private, desc = _public_state(s3)
                    line("ok" if private else "fail", f"public access: {desc}")

    # The mediator, and whether it takes the admin token.
    if not MEDIATOR:
        line("skip", "no S3TX_MEDIATOR: --to codes are off, --code still works")
    else:
        status, date, why = _http_status(f"{MEDIATOR}/api/get/Doctor0check")
        server_date = server_date or date
        if status is None:
            line("fail", f"mediator {MEDIATOR}: unreachable ({why})")
        elif status == 401:
            line("ok", f"mediator {MEDIATOR} answers")
        else:
            line(
                "warn", f"mediator {MEDIATOR} answered HTTP {status}, not 401: is it the mediator?"
            )
        if not ADMIN_TOKEN:
            line("warn", "no S3TX_ADMIN_TOKEN: --to cannot register codes")
        elif status is not None:
            # An empty registration: with a good token it is refused as a bad code (400),
            # and nothing is stored.
            reg, _, why = _http_status(
                f"{MEDIATOR}/api/register",
                data=b"{}",
                headers={
                    "Content-Type": "application/json",
                    "Authorization": f"Bearer {ADMIN_TOKEN}",
                },
            )
            if reg == 400:
                line("ok", "the mediator accepts S3TX_ADMIN_TOKEN (checked without registering)")
            elif reg == 401:
                line("fail", "the mediator refuses S3TX_ADMIN_TOKEN")
            else:
                line("warn", f"the admin token check got {reg or why}, not 400")

    # The clock: SigV4 signatures fail when it is more than 15 minutes off.
    try:
        skew = abs(time.time() - parsedate_to_datetime(server_date).timestamp())
    except (TypeError, ValueError):
        skew = None
    if skew is None:
        line("skip", "clock: not checked, no server answered with its time")
    elif skew <= 60:
        line("ok", f"clock: within {int(skew)}s of the server's")
    elif skew <= 900:
        line("warn", f"clock: {int(skew)}s off the server's; links still work, but set the time")
    else:
        line("fail", f"clock: {int(skew)}s off the server's; AWS refuses signatures 15 min off")

    # tx here, if any: the far ends run the same release.
    tx = shutil.which("tx")
    if not tx:
        line("skip", "tx is not on PATH here; only the far ends need it")
    else:
        try:
            run = subprocess.run([tx, "version"], capture_output=True, text=True, timeout=10)
            got = run.stdout.strip()
        except Exception:
            got = ""
        if got == f"tx {__version__}":
            line("ok", f"{got} at {tx}")
        elif got.startswith("tx "):
            line("warn", f"{got} at {tx}, not {__version__}: check the far ends' too")
        else:
            line("warn", f"tx at {tx} is older than 1.5.0 (no 'tx version'): update it")

    if counts["fail"]:
        die(f"{counts['fail']} check(s) failed.")
    (warn if counts["warn"] else ok)(
        f"No failures; {counts['warn']} warning(s) above." if counts["warn"] else "All checks pass."
    )


def cmd_codes(args):
    s3, _ = _preflight()
    now = int(time.time())
    live = [(c, e, u) for (c, e, u) in _manifest_read(s3) if e > now]
    if not live:
        info("(no live codes)")
        return
    for c, e, _u in sorted(live, key=lambda x: x[1]):
        print(f"{c:<12} expires in {(e - now) // 60:>4} min")


def main():
    # Settle the profile first: its settings decide the parser's defaults (--expires).
    pre = argparse.ArgumentParser(add_help=False)
    pre.add_argument("--profile")
    known, _rest = pre.parse_known_args()
    _apply(*_resolve(known.profile))

    common = argparse.ArgumentParser(add_help=False)
    common.add_argument(
        "--profile",
        metavar="NAME",
        default=argparse.SUPPRESS,
        help="use the [NAME] section of ~/.config/s3tx/config (default: [default])",
    )
    p = argparse.ArgumentParser(
        prog="s3tx",
        description="Move files via a PRIVATE S3 bucket using time-limited pre-signed URLs.",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog=EPILOG,
        parents=[common],
    )
    p.add_argument("--version", action="version", version=f"%(prog)s {__version__}")
    sub = p.add_subparsers(dest="cmd")

    def add(name, fn, help_):
        sp = sub.add_parser(name, help=help_, parents=[common])
        sp.set_defaults(fn=fn)
        return sp

    def with_expiry(sp):
        sp.add_argument(
            "--expires",
            type=int,
            default=EXPIRES,
            metavar="SECS",
            help=f"link lifetime in seconds (default {EXPIRES})",
        )
        return sp

    sp = add("send", cmd_send, "upload a file, print a download link for the far end")
    sp.add_argument("file", help="local file, or '-' to read stdin (then KEY is required)")
    sp.add_argument("key", nargs="?", help="S3 key (default: file's basename)")
    sp.add_argument(
        "--code",
        nargs="?",
        const="__auto__",
        metavar="CODE",
        help="also register a short code in the manifest (omit value to auto-generate); "
        "the far end then uses 'tx get CODE'",
    )
    sp.add_argument(
        "--to",
        metavar="CLIENT",
        help="register a scoped, single-use code via the mediator (S3TX_MEDIATOR) for CLIENT",
    )
    with_expiry(sp)

    sp = add("link", cmd_link, "make a fresh code/link for an object already in the bucket")
    sp.add_argument("key")
    sp.add_argument(
        "--to", metavar="CLIENT", help="scoped single-use code via the mediator for CLIENT"
    )
    sp.add_argument(
        "--code",
        nargs="?",
        const="__auto__",
        metavar="CODE",
        help="code via the S3 manifest (omit value to auto-generate)",
    )
    with_expiry(sp)

    sp = add("drop", cmd_drop, "print an UPLOAD link so the far end can push a file (no creds)")
    sp.add_argument("key")
    sp.add_argument(
        "--to",
        metavar="CLIENT",
        help="register a scoped, single-use UPLOAD code via the mediator for CLIENT",
    )
    with_expiry(sp)

    sp = add("recv", cmd_recv, "download an object to this machine")
    sp.add_argument("key")
    sp.add_argument("outfile", nargs="?", help="local path (default: key's basename)")

    sp = add("ls", cmd_ls, "list objects in the bucket")
    sp.add_argument("prefix", nargs="?", help="optional key prefix")

    sp = add("rm", cmd_rm, "delete one object")
    sp.add_argument("key")

    add("rmrf", cmd_rmrf, "delete EVERY object in the bucket (asks for confirmation)")
    add("status", cmd_status, "show identity, bucket, and confirm the bucket is private")
    add("lockdown", cmd_lockdown, "force Block-Public-Access ON and remove any bucket policy")

    sp = add(
        "manifest-url",
        cmd_manifest_url,
        "print a long-lived seed URL to the manifest (for TX_MANIFEST)",
    )
    sp.add_argument("--days", type=int, default=7, metavar="N", help="lifetime in days (max 7)")
    add("codes", cmd_codes, "list live manifest codes")
    add("config", cmd_config, "show the settings in effect and where they come from")
    add("doctor", cmd_doctor, "check the setup end to end, and say what to fix")
    add("help", lambda a: p.print_help(), "show this help")

    args = p.parse_args()
    if not getattr(args, "cmd", None) or args.cmd == "help":
        p.print_help()
        return
    if getattr(args, "expires", None) is not None:
        args.expires = _clamp_expires(args.expires)
    try:
        args.fn(args)
    except SystemExit:
        raise
    except KeyboardInterrupt:
        warn("\nInterrupted.")
        sys.exit(130)
    except Exception as e:
        die(f"{e.__class__.__name__}: {e}")


if __name__ == "__main__":
    main()
