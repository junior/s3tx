#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.9"
# dependencies = ["boto3>=1.36"]
# ///
# Supported: Python 3.11 or later. 3.9 and 3.10 are past their end of life but still run
# s3tx (CI checks 3.9, the jump hosts' Python), so the bound above stays low. boto3 1.36
# brought the checksum settings that S3-compatible servers need.
"""
s3tx: move files in and out of a locked-down environment through a PRIVATE S3
bucket, using time-limited pre-signed URLs.

Design goals (vs. the old public-bucket version):
  * The bucket is NEVER made public. Block Public Access stays fully ON. Access
    is granted per-object, time-boxed, via a signed URL, not via bucket policy.
  * The far end (corp laptop, a phone, a friend's place) needs NOTHING but curl
    or a web browser. No AWS CLI, no credentials there.
  * The authenticated side (this machine) needs AWS credentials + Python. boto3
    is auto-provisioned by uv, so the AWS CLI is not required here either.

Credentials: by default the tool uses the dedicated AWS profile named by
S3TX_AWS_PROFILE (default "s3tx"; S3TX_PROFILE is the older name for it), so it stays
on a least-privilege IAM user and does NOT touch your shell's default AWS credentials.
Set it empty to fall back to the standard boto3 chain (env vars, default profile, SSO).

Two workflows
  Send a file OUT (other end downloads):
      s3tx send report.pdf            # uploads, prints a download link + curl
  Receive a file IN (other end uploads, no creds needed there):
      s3tx drop inbox/file.zip        # prints an upload (PUT) link + curl
      s3tx recv inbox/file.zip        # pull it here once they've uploaded

Short codes: two ways for the far end to use a tiny code instead of a giant URL:
  --to <client> : scoped, single-use code via the Vercel mediator (needs S3TX_MEDIATOR
                  + S3TX_ADMIN_TOKEN); the client authenticates with its TX_CLIENT_ID.
  --code <code> : code stored in a private S3 manifest, no third party (far end seeds
                  TX_MANIFEST; see 's3tx manifest-url').

Settings: S3TX_AWS_PROFILE (default s3tx), S3TX_BUCKET (set it: the built-in s3tx goes
away in 2.0), S3TX_REGION
(default us-east-1), S3TX_ENDPOINT_URL + S3TX_CA_BUNDLE (an S3-compatible server instead
of AWS), S3TX_EXPIRES (default 600 = 10 min), S3TX_MANIFEST_KEY (default .s3tx-manifest),
S3TX_MEDIATOR + S3TX_ADMIN_TOKEN (for --to). Set them in the environment or in
~/.config/s3tx/config, which can also hold named profiles: see `s3tx config`.
"""

import argparse
import contextlib
import hashlib
import os
import re
import secrets
import sys
import time
from pathlib import Path

__version__ = "1.4.0"


def _as_int(name, raw, default):
    """int() a setting, falling back (with a warning) if it isn't numeric."""
    if not raw:
        return default
    try:
        return int(raw)
    except ValueError:
        print(f"Warning: {name}={raw!r} is not an integer; using {default}.", file=sys.stderr)
        return default


def _int_env(name, default):
    """int() an env var, falling back (with a warning) if it isn't numeric."""
    return _as_int(name, os.environ.get(name), default)


# Settings as the environment gives them; main() resolves them again for the profile in
# use (see the configuration section below). PROFILE is the AWS credentials profile.
CONFIG_PROFILE = "default"
PROFILE = os.environ.get("S3TX_AWS_PROFILE", os.environ.get("S3TX_PROFILE", "s3tx"))
BUCKET = os.environ.get("S3TX_BUCKET", "s3tx")
REGION = os.environ.get("S3TX_REGION", "us-east-1")
EXPIRES = _int_env("S3TX_EXPIRES", 600)
MAX_EXPIRES = 604800  # 7 days, SigV4's hard cap for pre-signed URLs
MANIFEST_KEY = os.environ.get("S3TX_MANIFEST_KEY", ".s3tx-manifest")
MEDIATOR = os.environ.get("S3TX_MEDIATOR", "").rstrip("/")
ADMIN_TOKEN = os.environ.get("S3TX_ADMIN_TOKEN", "")
ENDPOINT_URL = os.environ.get("S3TX_ENDPOINT_URL", "")
CA_BUNDLE = os.environ.get("S3TX_CA_BUNDLE", "")

EPILOG = """\
How the far end receives it (use with `send` or `link`):
  --to CLIENT     short code via the mediator (recommended)    far end: tx get CODE
  --code [CODE]   short code via the S3 manifest (fallback)    far end: tx get CODE
  (neither)       a plain time-limited URL                     far end: tx get "URL"

Examples:
  s3tx send report.pdf --to laptop       upload + get a code
  s3tx link report.pdf --to laptop       fresh code for a file already in the bucket
  s3tx drop report.pdf --to laptop       receive a file (saved at key 'report.pdf')
  s3tx ls                                list objects
  s3tx codes                             list live codes
  s3tx recv KEY                          download a file
  s3tx rm KEY                            delete one object
  s3tx --profile NAME config             what the [NAME] profile sets
  s3tx doctor                            check the whole setup

Many files, far end -> you:
    (Mac)      s3tx drop bundle.tgz --to laptop
    (far end)  tar czf - f1 dir/ | tx put - CODE
    (Mac)      s3tx recv bundle.tgz             (then: tar xzf bundle.tgz)

