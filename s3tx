#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.9"
# dependencies = ["boto3"]
# ///
"""
s3tx — move files in and out of a locked-down environment through a PRIVATE S3
bucket, using time-limited pre-signed URLs.

Design goals (vs. the old public-bucket version):
  * The bucket is NEVER made public. Block Public Access stays fully ON. Access
    is granted per-object, time-boxed, via a signed URL — not via bucket policy.
  * The far end (corp laptop, a phone, a friend's place) needs NOTHING but curl
    or a web browser. No AWS CLI, no credentials there.
  * The authenticated side (this machine) needs AWS credentials + Python. boto3
    is auto-provisioned by uv, so the AWS CLI is not required here either.

Credentials: by default the tool uses the dedicated AWS profile named by
S3TX_PROFILE (default "s3tx"), so it stays on a least-privilege IAM user and does
NOT touch your shell's default AWS credentials. Set S3TX_PROFILE= (empty) to fall
back to the standard boto3 chain (env vars, default profile, SSO).

Two workflows
  Send a file OUT (other end downloads):
      s3tx send report.pdf            # uploads, prints a download link + curl
  Receive a file IN (other end uploads, no creds needed there):
      s3tx drop inbox/file.zip        # prints an upload (PUT) link + curl
      s3tx recv inbox/file.zip        # pull it here once they've uploaded

Short codes — two ways for the far end to use a tiny code instead of a giant URL:
  --to <client> : scoped, single-use code via the Vercel mediator (needs S3TX_MEDIATOR
                  + S3TX_ADMIN_TOKEN); the client authenticates with its TX_CLIENT_ID.
  --code <code> : code stored in a private S3 manifest, no third party (far end seeds
                  TX_MANIFEST — see 's3tx manifest-url').

Config via env: S3TX_PROFILE (default s3tx), S3TX_BUCKET (default s3tx),
S3TX_REGION (default us-east-1), S3TX_EXPIRES (default 600 = 10 min),
S3TX_MANIFEST_KEY (default .s3tx-manifest), S3TX_MEDIATOR + S3TX_ADMIN_TOKEN (for --to).
"""

import argparse
import os
import random
import string
import sys
import time

PROFILE = os.environ.get("S3TX_PROFILE", "s3tx")
BUCKET = os.environ.get("S3TX_BUCKET", "s3tx")
REGION = os.environ.get("S3TX_REGION", "us-east-1")
EXPIRES = int(os.environ.get("S3TX_EXPIRES", "600"))
MANIFEST_KEY = os.environ.get("S3TX_MANIFEST_KEY", ".s3tx-manifest")
MEDIATOR = os.environ.get("S3TX_MEDIATOR", "").rstrip("/")
ADMIN_TOKEN = os.environ.get("S3TX_ADMIN_TOKEN", "")

EPILOG = """\
How the far end receives it (use with `send` or `link`):
  --to CLIENT     short code via the mediator (recommended)    far end: tx get CODE
  --code [CODE]   short code via the S3 manifest (fallback)    far end: tx get CODE
  (neither)       a plain time-limited URL                     far end: tx get "URL"

Examples:
  s3tx send report.pdf --to wsl-work     upload + get a code
  s3tx link report.pdf --to wsl-work     fresh code for a file already in the bucket
  s3tx drop report.pdf --to wsl-work     receive a file (saved at key 'report.pdf')
  s3tx ls                                list objects
  s3tx codes                             list live codes
  s3tx recv KEY                          download a file
  s3tx rm KEY                            delete one object

Many files, far end → you:   
    (Mac)      s3tx drop bundle.tgz --to wsl-work
    (far end)  tar czf - f1 dir/ | tx put - CODE
    (Mac)      s3tx recv bundle.tgz             (then: tar xzf bundle.tgz)

Many files, you → far end:
    (Mac)      tar czf - file1 dir/ | s3tx send - bundle.tgz --to wsl-work
    (far end)  tx get CODE                      (then: tar xzf bundle.tgz)
"""

# --- tiny color helpers (quiet when not a TTY or NO_COLOR is set) ---
_tty = sys.stdout.isatty() and not os.environ.get("NO_COLOR")


def _c(code, s):
    return f"\033[{code}m{s}\033[0m" if _tty else s


def info(s):
    print(_c("36", s))


def ok(s):
    print(_c("32", s))


def warn(s):
    print(_c("33", s), file=sys.stderr)


def die(s):
    print(_c("31", f"Error: {s}"), file=sys.stderr)
    sys.exit(1)


# boto3 is imported lazily inside these helpers so that `s3tx` / `s3tx -h`
# work with no dependencies and no credentials.
_SESSION = None


def _session():
    """A boto3 Session pinned to S3TX_PROFILE, so the tool uses its own
    least-privilege IAM user and never the shell's default credentials.
    Set S3TX_PROFILE= (empty) to use the standard boto3 chain instead."""
    global _SESSION
    if _SESSION is None:
        import boto3
        from botocore.exceptions import ProfileNotFound

        try:
            _SESSION = boto3.Session(profile_name=PROFILE or None, region_name=REGION)
        except ProfileNotFound:
            die(
                f"AWS profile '{PROFILE}' not found. Create it with "
                f"'aws configure --profile {PROFILE}', or set S3TX_PROFILE= to use "
                "the default credentials."
            )
    return _SESSION


def _s3():
    return _session().client("s3")


def _preflight():
    """Verify credentials and that the bucket already exists. Never creates anything."""
    s3 = _s3()
    where = f"profile '{PROFILE}'" if PROFILE else "the default credential chain"
    try:
        ident = _session().client("sts").get_caller_identity()
    except Exception as e:
        die(
            f"AWS credentials for {where} are not available or not authorized "
            f"({e.__class__.__name__})."
        )
    try:
        s3.head_bucket(Bucket=BUCKET)
    except Exception as e:
        die(
            f"bucket s3://{BUCKET} is not accessible in {REGION} "
            f"({e.__class__.__name__}). s3tx never creates buckets."
        )
    return s3, ident


def _expiry_note(secs):
    info(
        f"\nLink expires in {secs}s (~{max(1, secs // 60)} min). Treat it as a "
        "secret; the real expiry is also capped by your AWS session length."
    )


def _public_state(s3):
    try:
        pab = s3.get_public_access_block(Bucket=BUCKET)["PublicAccessBlockConfiguration"]
    except Exception:
        return False, "no Block-Public-Access config set — run: s3tx lockdown"
    flags = ("BlockPublicAcls", "IgnorePublicAcls", "BlockPublicPolicy", "RestrictPublicBuckets")
    if all(pab.get(f) for f in flags):
        return True, "private (all four Block-Public-Access flags ON)"
    return False, "PARTIALLY OPEN — run: s3tx lockdown"


def _manifest_read(s3):
    """Return [(code, expires_epoch, url)]; a missing/garbled manifest -> []."""
    try:
        body = s3.get_object(Bucket=BUCKET, Key=MANIFEST_KEY)["Body"].read().decode("utf-8")
    except Exception:
        return []
    out = []
    for line in body.splitlines():
        parts = line.split("\t")
        if len(parts) == 3 and parts[1].isdigit():
            out.append((parts[0], int(parts[1]), parts[2]))
    return out


def _manifest_write(s3, entries):
    body = "".join(f"{c}\t{e}\t{u}\n" for c, e, u in entries)
    s3.put_object(
        Bucket=BUCKET, Key=MANIFEST_KEY, Body=body.encode("utf-8"), ContentType="text/plain"
    )


def _manifest_upsert(s3, code, url, expires):
    now = int(time.time())
    kept = [(c, e, u) for (c, e, u) in _manifest_read(s3) if e > now and c != code]
    kept.append((code, now + expires, url))
    _manifest_write(s3, kept)


_CODE_ALPHABET = "23456789abcdefghijkmnpqrstuvwxyzABCDEFGHJKLMNPQRSTUVWXYZ"


def _gen_code(n=8):
    return "".join(random.choice(_CODE_ALPHABET) for _ in range(n))


def _mediator_register(code, url, client, method, ttl):
    import json
    import urllib.error
    import urllib.request

    if not MEDIATOR or not ADMIN_TOKEN:
        die("S3TX_MEDIATOR and S3TX_ADMIN_TOKEN must be set to use --to.")
    body = json.dumps(
        {"code": code, "url": url, "client": client, "method": method, "ttl": ttl}
    ).encode()
    req = urllib.request.Request(
        f"{MEDIATOR}/api/register",
        data=body,
        method="POST",
        headers={"Content-Type": "application/json", "Authorization": f"Bearer {ADMIN_TOKEN}"},
    )
    try:
        urllib.request.urlopen(req, timeout=10).read()
    except urllib.error.HTTPError as e:
        die(f"mediator register failed (HTTP {e.code}): {e.read().decode()[:200]}")
    except Exception as e:
        die(f"mediator unreachable: {e}")


def _emit_get(s3, key, url, args):
    """Print the right thing for a GET pre-signed URL: a mediator code (--to),
    a manifest code (--code), or the raw time-limited URL."""
    if args.to:
        code = _gen_code(8)
        _mediator_register(code, url, args.to, "GET", args.expires)
        ok(f"Registered for client '{args.to}' (single-use, expires {args.expires}s). On that machine:")
        print(f"  tx get {code}")
    elif args.code is not None:
        code = _gen_code() if args.code == "__auto__" else args.code
        _manifest_upsert(s3, code, url, args.expires)
        ok(f"Registered as manifest code (expires {args.expires}s). On the far end (TX_MANIFEST seeded):")
        print(f"  tx get {code}")
    else:
        ok(f"Time-limited download link (expires {args.expires}s):")
        print(url)
        info('On the far end:  tx get "<that url>"   (or: curl -L -O "<that url>")')
    _expiry_note(args.expires)


def cmd_send(args):
    if args.file == "-":
        if not args.key:
            die("reading from stdin needs an explicit key, e.g. s3tx send - bundle.tgz --to wsl-work")
        key = args.key
        s3, _ = _preflight()
        info(f"Uploading (stdin) → s3://{BUCKET}/{key} ...")
        s3.upload_fileobj(sys.stdin.buffer, BUCKET, key)  # boto3 multipart: handles a pipe
    else:
        if not os.path.isfile(args.file):
            die(f"file not found: {args.file}")
        key = args.key or os.path.basename(args.file)
        s3, _ = _preflight()
        info(f"Uploading {args.file} → s3://{BUCKET}/{key} ...")
        s3.upload_file(args.file, BUCKET, key)
    url = s3.generate_presigned_url(
        "get_object", Params={"Bucket": BUCKET, "Key": key}, ExpiresIn=args.expires
    )
    _emit_get(s3, key, url, args)


def cmd_link(args):
    s3, _ = _preflight()
    try:
        s3.head_object(Bucket=BUCKET, Key=args.key)
    except Exception:
        die(f"object not found: s3://{BUCKET}/{args.key}")
    url = s3.generate_presigned_url(
        "get_object", Params={"Bucket": BUCKET, "Key": args.key}, ExpiresIn=args.expires
    )
    _emit_get(s3, args.key, url, args)


def cmd_drop(args):
    s3, _ = _preflight()
    url = s3.generate_presigned_url(
        "put_object", Params={"Bucket": BUCKET, "Key": args.key}, ExpiresIn=args.expires
    )
    if args.to:
        code = _gen_code(8)
        _mediator_register(code, url, args.to, "PUT", args.expires)
        ok(f"Upload slot registered for client '{args.to}' (single-use).")
        info("\nOn that machine (tx with TX_MEDIATOR + TX_CLIENT_ID set):")
        print(f"  tx put <localfile> {code}")
        info(f"Then pull it here:  s3tx recv {args.key}")
        _expiry_note(args.expires)
        return
    ok(f"Upload link for s3://{BUCKET}/{args.key} (far end needs no AWS creds):")
    print(url)
    info("\nOn the far end (wsl-work, Pi, …):")
    print(f'  tx put <localfile> "{url}"')
    info("  …or with plain curl:")
    print(f'  curl -X PUT --upload-file <localfile> "{url}"')
    info(f"Then pull it here:  s3tx recv {args.key}")
    _expiry_note(args.expires)


def cmd_recv(args):
    s3, _ = _preflight()
    out = args.outfile or os.path.basename(args.key)
    info(f"Downloading s3://{BUCKET}/{args.key} → {out} ...")
    s3.download_file(BUCKET, args.key, out)
    ok(f"Saved {out}")


def cmd_ls(args):
    s3, _ = _preflight()
    n = 0
    for page in s3.get_paginator("list_objects_v2").paginate(Bucket=BUCKET, Prefix=args.prefix or ""):
        for o in page.get("Contents", []):
            print(f"{o['LastModified']:%Y-%m-%d %H:%M}  {o['Size']:>12,}  {o['Key']}")
            n += 1
    if not n:
        info("(empty)")


def cmd_rm(args):
    s3, _ = _preflight()
    s3.delete_object(Bucket=BUCKET, Key=args.key)
    ok(f"Deleted s3://{BUCKET}/{args.key}")


def cmd_rmrf(args):
    s3, _ = _preflight()
    warn(f"This will DELETE ALL objects in s3://{BUCKET}")
    if input("Type DELETE to confirm: ") != "DELETE":
        warn("Cancelled.")
        sys.exit(1)
    keys = [
        {"Key": o["Key"]}
        for page in s3.get_paginator("list_objects_v2").paginate(Bucket=BUCKET)
        for o in page.get("Contents", [])
    ]
    for i in range(0, len(keys), 1000):
        s3.delete_objects(Bucket=BUCKET, Delete={"Objects": keys[i : i + 1000]})
    ok(f"Emptied ({len(keys)} objects).")


def cmd_status(args):
    s3, ident = _preflight()
    info(f"Profile  : {PROFILE or '(default credential chain)'}")
    info(f"Identity : {ident['Arn']}")
    info(f"Bucket   : s3://{BUCKET}    Region: {REGION}")
    private, desc = _public_state(s3)
    (ok if private else warn)(f"Public access: {desc}")


def cmd_lockdown(args):
    s3, _ = _preflight()
    s3.put_public_access_block(
        Bucket=BUCKET,
        PublicAccessBlockConfiguration={
            "BlockPublicAcls": True,
            "IgnorePublicAcls": True,
            "BlockPublicPolicy": True,
            "RestrictPublicBuckets": True,
        },
    )
    try:
        s3.delete_bucket_policy(Bucket=BUCKET)
    except Exception:
        pass
    ok("Locked down: all Block-Public-Access flags ON, any bucket policy removed.")


def cmd_manifest_url(args):
    s3, _ = _preflight()
    days = max(1, min(args.days, 7))
    if not _manifest_read(s3):
        _manifest_write(s3, [])  # ensure the object exists so the seed URL resolves
    url = s3.generate_presigned_url(
        "get_object", Params={"Bucket": BUCKET, "Key": MANIFEST_KEY}, ExpiresIn=days * 86400
    )
    ok(f"Manifest seed URL (valid {days} day(s) — SigV4 max is 7):")
    print(url)
    info("\nSeed it on the far end once, then 'tx get <code>' works:")
    print(f'  export TX_MANIFEST="{url}"')
    info("  …or persist it (tx reads this when the env var is unset):")
    print(f'  mkdir -p ~/.config/tx && printf %s "{url}" > ~/.config/tx/manifest.url')


def cmd_codes(args):
    s3, _ = _preflight()
    now = int(time.time())
    live = [(c, e, u) for (c, e, u) in _manifest_read(s3) if e > now]
    if not live:
        info("(no live codes)")
        return
    for c, e, _u in sorted(live, key=lambda x: x[1]):
        print(f"{c:<12} expires in {(e - now) // 60:>4} min")


def main():
    p = argparse.ArgumentParser(
        prog="s3tx",
        description="Move files via a PRIVATE S3 bucket using time-limited pre-signed URLs.",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog=EPILOG,
    )
    sub = p.add_subparsers(dest="cmd")

    def add(name, fn, help_):
        sp = sub.add_parser(name, help=help_)
        sp.set_defaults(fn=fn)
        return sp

    def with_expiry(sp):
        sp.add_argument(
            "--expires", type=int, default=EXPIRES, metavar="SECS",
            help=f"link lifetime in seconds (default {EXPIRES})",
        )
        return sp

    sp = add("send", cmd_send, "upload a file, print a download link for the far end")
    sp.add_argument("file", help="local file, or '-' to read stdin (then KEY is required)")
    sp.add_argument("key", nargs="?", help="S3 key (default: file's basename)")
    sp.add_argument(
        "--code", nargs="?", const="__auto__", metavar="CODE",
        help="also register a short code in the manifest (omit value to auto-generate); "
             "the far end then uses 'tx get CODE'",
    )
    sp.add_argument(
        "--to", metavar="CLIENT",
        help="register a scoped, single-use code via the mediator (S3TX_MEDIATOR) for CLIENT",
    )
    with_expiry(sp)

    sp = add("link", cmd_link, "make a fresh code/link for an object already in the bucket")
    sp.add_argument("key")
    sp.add_argument("--to", metavar="CLIENT", help="scoped single-use code via the mediator for CLIENT")
    sp.add_argument(
        "--code", nargs="?", const="__auto__", metavar="CODE",
        help="code via the S3 manifest (omit value to auto-generate)",
    )
    with_expiry(sp)

    sp = add("drop", cmd_drop, "print an UPLOAD link so the far end can push a file (no creds)")
    sp.add_argument("key")
    sp.add_argument(
        "--to", metavar="CLIENT",
        help="register a scoped, single-use UPLOAD code via the mediator for CLIENT",
    )
    with_expiry(sp)

    sp = add("recv", cmd_recv, "download an object to this machine")
    sp.add_argument("key")
    sp.add_argument("outfile", nargs="?", help="local path (default: key's basename)")

    sp = add("ls", cmd_ls, "list objects in the bucket")
    sp.add_argument("prefix", nargs="?", help="optional key prefix")

    sp = add("rm", cmd_rm, "delete one object")
    sp.add_argument("key")

    add("rmrf", cmd_rmrf, "delete EVERY object in the bucket (asks for confirmation)")
    add("status", cmd_status, "show identity, bucket, and confirm the bucket is private")
    add("lockdown", cmd_lockdown, "force Block-Public-Access ON and remove any bucket policy")

    sp = add("manifest-url", cmd_manifest_url, "print a long-lived seed URL to the manifest (for TX_MANIFEST)")
    sp.add_argument("--days", type=int, default=7, metavar="N", help="lifetime in days (max 7)")
    add("codes", cmd_codes, "list live manifest codes")
    add("help", lambda a: p.print_help(), "show this help")

    args = p.parse_args()
    if not getattr(args, "cmd", None) or args.cmd == "help":
        p.print_help()
        return
    try:
        args.fn(args)
    except SystemExit:
        raise
    except KeyboardInterrupt:
        warn("\nInterrupted.")
        sys.exit(130)
    except Exception as e:
        die(f"{e.__class__.__name__}: {e}")


if __name__ == "__main__":
    main()
