#!/usr/bin/env sh
# tx: transfer a file to/from a URL or a short code, using only curl.
#
# A URL (e.g. a pre-signed S3 URL) carries its own auth. A short code is resolved
# to a URL via one of two backends, configured once on this box:
#   TX_MEDIATOR + TX_CLIENT_ID : an authenticated mediator. The code is scoped to this
#                                client and single-use; TX_CLIENT_ID is sent as a
#                                header, never in a URL, and never typed.
#   TX_MANIFEST (or ~/.config/tx/manifest.url) : a pre-signed S3 manifest, no 3rd party.
# Set these ONCE in ~/.config/tx/config (chmod 600, since TX_CLIENT_ID is a secret) so
# you needn't export them in every shell. The file holds KEY=VALUE lines and may hold
# named profiles in [name] sections; lines before any section are [default]. It is read,
# never executed. The default profile lets the environment override the file; a profile
# chosen with --profile NAME uses its own [NAME] lines and nothing else.
# Portable to anything with a POSIX shell + curl: Linux, WSL, Raspberry Pi, ...
#
# Usage:
#   tx [--profile NAME] get <url|code> [outfile]   download, to a file or into a folder
#   tx [--profile NAME] put <file|-> <url|code>    upload a file (or '-' = stdin) via HTTP PUT
#   tx [--profile NAME] config                     show the settings in use
#   tx version                                     print tx's version
#   tx help

set -eu

prog=tx
version=1.4.0 # the release's; the tests hold it equal to s3tx's __version__

die() { printf '%s: %s\n' "$prog" "$*" >&2; exit 1; }

usage() {
  cat <<EOF
Usage:
  $prog get <url|code> [outfile]   download (code via TX_MEDIATOR or TX_MANIFEST)
  $prog put <file|-> <url|code>    upload a file (or '-' = stdin) via HTTP PUT
  $prog config                     show the settings in use, secrets masked
  $prog version                    print tx's version
  $prog help

Options, before the command:
  --profile NAME   use the [NAME] section of ~/.config/tx/config (default: [default])

A value starting with http(s):// is used as-is; otherwise it is a short code,
resolved via \$TX_MEDIATOR (+ \$TX_CLIENT_ID) or \$TX_MANIFEST.

With no outfile, or with a folder as the outfile, get keeps the file's own name:
the last part of its URL. When s3tx recorded the file's SHA-256, get checks the
download against it.
EOF
}

command -v curl >/dev/null 2>&1 || die "curl is required but was not found"

profile=default
while [ $# -gt 0 ]; do
  case $1 in
    --profile) [ $# -ge 2 ] || die "--profile needs a profile name"; profile=$2; shift 2 ;;
    --profile=*) profile=${1#--profile=}; shift ;;
    *) break ;;
  esac
done
case $profile in
  '' | *[!A-Za-z0-9_.-]*) die "a profile name is letters, digits, dot, underscore or hyphen" ;;
esac

cfg_file="$HOME/.config/tx/config"
tab=$(printf '\t')

# The config grammar, the same as s3tx's (the tests hold both to one set of fixtures):
# KEY=VALUE lines, # comments, optional quotes and `export`, [name] section headers.
# Prints the wanted section's settings as K<TAB>KEY<TAB>VALUE and S<TAB>1 when that
# section exists; for a malformed line, E<TAB>line<TAB>reason and exit status 2.
read_config_awk='
function fail(msg) { printf "E\t%d\t%s\n", NR, msg; bad = 1; exit 2 }
BEGIN { section = "default" }
{
  line = $0
  sub(/\r$/, "", line); sub(/^[ \t]+/, "", line); sub(/[ \t]+$/, "", line)
  if (line == "" || substr(line, 1, 1) == "#") next
  if (substr(line, 1, 1) == "[") {
    if (line !~ /^\[[ \t]*[A-Za-z0-9_.-]+[ \t]*\][ \t]*(#.*)?$/)
      fail("a section header is [name], with letters, digits, dot, underscore or hyphen")
    section = line
    sub(/^\[[ \t]*/, "", section); sub(/[ \t]*\].*$/, "", section)
    if (section == want) found = 1
    next
  }
  rest = line
  if (rest ~ /^export[ \t]+[A-Za-z_][A-Za-z0-9_]*[ \t]*=/) sub(/^export[ \t]+/, "", rest)
  if (!match(rest, /^[A-Za-z_][A-Za-z0-9_]*[ \t]*=/)) fail("expected KEY=VALUE or a [section] header")
  key = substr(rest, 1, RLENGTH - 1); sub(/[ \t]+$/, "", key)
  rest = substr(rest, RLENGTH + 1); sub(/^[ \t]+/, "", rest)
  q = substr(rest, 1, 1)
  if (q == "\"" || q == "\047") {
    rest = substr(rest, 2); e = index(rest, q)
    if (e == 0) fail("the quoted value never ends")
    value = substr(rest, 1, e - 1); tail = substr(rest, e + 1)
  } else if (q == "#") {
    value = ""; tail = ""
  } else if (match(rest, /[ \t]/)) {
    value = substr(rest, 1, RSTART - 1); tail = substr(rest, RSTART)
  } else {
    value = rest; tail = ""
  }
  sub(/^[ \t]+/, "", tail)
  if (tail != "" && substr(tail, 1, 1) != "#") fail("a value with spaces needs quotes")
  if (section == want) { vals[key] = value; keys[key] = 1 }
}
END {
  if (bad) exit 2
  if (want == "default") found = 1
  for (k in keys) printf "K\t%s\t%s\n", k, vals[k]
  printf "S\t%d\n", found
}'

# Load the profile's settings from the config file, then settle each one: for the
# default profile the environment wins, a named profile takes only its own lines.
load_config() {
  cfg_found=0 cfg_mediator='' cfg_client='' cfg_manifest=''
  has_mediator='' has_client='' has_manifest=''
  src_TX_MEDIATOR=unset src_TX_CLIENT_ID=unset src_TX_MANIFEST=unset
  if [ -r "$cfg_file" ]; then
    case $(ls -ld "$cfg_file" 2>/dev/null) in
      -???------*) ;;
      *) printf '%s: %s is readable by other users, and it holds TX_CLIENT_ID: chmod 600 it\n' \
           "$prog" "$cfg_file" >&2 ;;
    esac
    parsed=$(awk -v want="$profile" "$read_config_awk" "$cfg_file") || {
      why=$(printf '%s\n' "$parsed" | awk -F"$tab" '$1 == "E" { print "line " $2 ": " $3; exit }')
      die "$cfg_file, ${why:-cannot be read}"
    }
    while IFS=$tab read -r tag k v; do
      case $tag in
        S) cfg_found=$k ;;
        K) case $k in
             TX_MEDIATOR) cfg_mediator=$v has_mediator=1 ;;
             TX_CLIENT_ID) cfg_client=$v has_client=1 ;;
             TX_MANIFEST) cfg_manifest=$v has_manifest=1 ;;
           esac ;;
      esac
    done <<EOF
$parsed
EOF
  fi
  if [ "$profile" != default ] && [ "$cfg_found" != 1 ]; then
    [ -r "$cfg_file" ] || die "there is no profile [$profile] because $cfg_file does not exist"
    die "there is no profile [$profile] in $cfg_file"
  fi
  settle TX_MEDIATOR "$has_mediator" "$cfg_mediator"
  settle TX_CLIENT_ID "$has_client" "$cfg_client"
  settle TX_MANIFEST "$has_manifest" "$cfg_manifest"
}

# settle VAR HAS VALUE: VAR's environment value (default profile only), else the file's
# VALUE when HAS is set, else empty; src_VAR records which (env, file or unset).
settle() {
  eval "_env=\${$1:-}"
  if [ "$profile" = default ] && [ -n "$_env" ]; then
    eval "src_$1=env"
  elif [ -n "$2" ]; then
    eval "$1=\$3 src_$1=file"
  else
    eval "$1= src_$1=unset"
  fi
}

# secret_line KEY VALUE SOURCE: a setting for `tx config`, a secret shown by its length only
secret_line() {
  if [ -n "$2" ]; then printf '%s=<set, %s characters>  [%s]\n' "$1" "${#2}" "$3"
  else printf '%s=  [%s]\n' "$1" "$3"; fi
}

manifest_seed() {
  if [ -n "${TX_MANIFEST:-}" ]; then
    printf '%s' "$TX_MANIFEST"
  elif [ "$profile" = default ] && [ -r "$HOME/.config/tx/manifest.url" ]; then
    cat "$HOME/.config/tx/manifest.url"
  fi
}

# Echo a URL for "$1" (a URL or a short code), or die.
resolve() {
  case "$1" in
    http://* | https://*) printf '%s' "$1"; return ;;
  esac
  if [ -n "${TX_MEDIATOR:-}" ]; then
    [ -n "${TX_CLIENT_ID:-}" ] || die "TX_MEDIATOR is set but TX_CLIENT_ID is not"
    # Strip stray whitespace/CR: a config saved with Windows CRLF endings leaves a
    # trailing \r on the value, which silently corrupts the header/URL -> 403.
    _med=$(printf %s "${TX_MEDIATOR%/}" | tr -d '[:space:]')
    _cid=$(printf %s "$TX_CLIENT_ID" | tr -d '[:space:]')
    t=$(mktemp 2>/dev/null) || t="./.tx.$$.r"
    c=$(curl -sS --connect-timeout 10 --max-time 25 -o "$t" -w '%{http_code}' \
        -H "X-Client-Id: $_cid" "$_med/api/get/$1") \
        || { rm -f "$t"; die "mediator unreachable (timed out: is $_med blocked here?)"; }
    if [ "$c" = 200 ]; then u=$(cat "$t"); rm -f "$t"; printf '%s' "$u"; return; fi
    m=$(cat "$t"); rm -f "$t"
    # A code the mediator does not know may be a manifest code: try the manifest next,
    # when this machine has one. Any other refusal stands.
    if [ "$c" != 404 ] || [ -z "$(manifest_seed)" ]; then die "mediator refused: $m (HTTP $c)"; fi
  fi
  seed=$(manifest_seed)
  [ -n "$seed" ] || die "'$1' is not a URL and neither TX_MEDIATOR nor TX_MANIFEST is set"
  u=$(curl -fsSL --connect-timeout 10 --max-time 25 "$seed" | awk -F'\t' -v k="$1" '$1==k{print $3; f=1} END{exit !f}') \
    || die "code '$1' not found (manifest empty, code wrong, or seed expired/unreachable)"
  printf '%s' "$u"
}

# Echo the mode a new file gets here, 666 less the umask, one digit at a time: no shell
# then has to read a leading 0 as octal (zsh, for one, does not).
new_file_mode() {
  u=$(umask); u=${u#"${u%???}"}; mid=${u#?}
  printf '%s%s%s' "$((6 & ~${u%??}))" "$((6 & ~${mid%?}))" "$((6 & ~${u#??}))"
}

# Echo the SHA-256 of file "$1" with whichever tool this machine has, or nothing.
sha256_of() {
  if command -v sha256sum >/dev/null 2>&1; then sha256sum < "$1" | awk '{ print $1 }'
  elif command -v shasum >/dev/null 2>&1; then shasum -a 256 < "$1" | awk '{ print $1 }'
  elif command -v openssl >/dev/null 2>&1; then openssl dgst -sha256 < "$1" | awk '{ print $NF }'
  fi
}

cmd=${1:-help}
case "$cmd" in
  get | put | config) load_config ;;
esac

case "$cmd" in
  config)
    found=; [ -r "$cfg_file" ] || found=", which does not exist"
    printf 'Profile [%s] from %s%s\n' "$profile" "$cfg_file" "$found"
    printf 'TX_MEDIATOR=%s  [%s]\n' "$TX_MEDIATOR" "$src_TX_MEDIATOR"
    secret_line TX_CLIENT_ID "$TX_CLIENT_ID" "$src_TX_CLIENT_ID"
    secret_line TX_MANIFEST "$TX_MANIFEST" "$src_TX_MANIFEST"
    ;;
  get)
    [ $# -ge 2 ] || die "usage: $prog get <url|code> [outfile]"
    out=${3:-} into=
    # Check the target folder before resolving: a code works only once, so a wrong
    # folder must not spend it. An outfile that is a folder keeps the file's own name.
    if [ -n "$out" ] && [ -d "$out" ]; then
      into=$out folder=$out
    else
      case $out in
        */) folder=$out ;;
        */*) folder=${out%/*}/ ;;
        *) folder=. ;;
      esac
      [ -d "$folder" ] || die "folder not found: $folder"
    fi
    [ -w "$folder" ] || die "cannot write into folder: $folder"
    url=$(resolve "$2")
    tmp=$(mktemp 2>/dev/null) || tmp="./.tx.$$.tmp"
    hdr=$(mktemp 2>/dev/null) || hdr="./.tx.$$.hdr"
    printf 'Downloading ...\n' >&2
    eff=$(curl -fSL --connect-timeout 15 --progress-bar -D "$hdr" -o "$tmp" -w '%{url_effective}' "$url") \
      || { rm -f "$tmp" "$hdr"; die "download failed: link expired/wrong/revoked, or host blocked here"; }
    # s3tx send records the file's SHA-256 with the object, and S3 returns it as a header.
    want=$(awk 'tolower($1) == "x-amz-meta-sha256:" { v = $2 } END { sub(/\r$/, "", v); print tolower(v) }' "$hdr")
    rm -f "$hdr"
    case $want in *[!0-9a-f]*) want= ;; esac
    [ ${#want} -eq 64 ] || want=
    checked=
    if [ -n "$want" ]; then
      got=$(sha256_of "$tmp")
      if [ -z "$got" ]; then
        printf 'Not verified: there is no sha256sum, shasum or openssl here\n' >&2
      elif [ "$got" != "$want" ]; then
        die "the download does not match the SHA-256 s3tx recorded; it is kept in $tmp"
      else
        checked=", SHA-256 verified"
      fi
    fi
    if [ -z "$out" ] || [ -n "$into" ]; then
      name=${eff%%\?*}
      name=${name##*/}
      [ -n "$name" ] || name=download
      if [ -n "$into" ]; then out=${into%/}/$name; else out=$name; fi
    fi
    # A folder of that name in the way: keep the download, since the code is spent.
    [ ! -d "$out" ] || die "$out is a folder; the download is in $tmp"
    # mktemp made the file 0600: give it the mode a new file gets here, as curl -o would.
    chmod "$(new_file_mode)" "$tmp"
    mv -f "$tmp" "$out"
    printf 'Saved %s%s\n' "$out" "$checked" >&2
    ;;
  put)
    [ $# -ge 3 ] || die "usage: $prog put <file|-> <url|code>"
    src=$2
    url=$(resolve "$3")
    tmp=
    if [ "$src" = "-" ]; then
      # S3 pre-signed PUT needs a known Content-Length; a chunked stdin upload is
      # rejected (HTTP 501). Spool stdin to a temp file (auto-removed), then PUT.
      tmp=$(mktemp 2>/dev/null) || tmp="./.tx.$$.put"
      cat > "$tmp"
      file=$tmp; label='(stdin)'
    else
      [ -f "$src" ] || die "file not found: $src"
      file=$src; label=$src
    fi
    printf 'Uploading %s ...\n' "$label" >&2
    if ! curl -fSL --connect-timeout 15 --progress-bar -X PUT --upload-file "$file" "$url"; then
      [ -z "$tmp" ] || rm -f "$tmp"
      die "upload failed: link expired/wrong/not-a-PUT-URL, or host blocked here"
    fi
    [ -z "$tmp" ] || rm -f "$tmp"
    printf 'Uploaded %s\n' "$label" >&2
    ;;
  version | --version)
    printf '%s %s\n' "$prog" "$version"
    ;;
  help | -h | --help | "")
    usage
    ;;
  *)
    die "unknown command: $cmd (try '$prog help')"
    ;;
esac
